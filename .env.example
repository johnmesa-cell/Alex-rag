# ==========================================
# CONFIGURACIÓN DE N8N
# ==========================================

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false

# Generar una clave propia para cada instalación.
# Ejemplo para generarla: openssl rand -hex 32
N8N_ENCRYPTION_KEY=REEMPLAZAR_CON_CLAVE_PROPIA

# Zona horaria
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota


# ==========================================
# CONFIGURACIÓN DEL BOT DE DISCORD
# ==========================================

# Token del bot de Discord
DISCORD_TOKEN=

# IDs de los cuatro canales autorizados.
# Reemplazar por los IDs de los canales del servidor propio.
DISCORD_ALLOWED_CHANNEL_IDS=ID_CANAL_1,ID_CANAL_2,ID_CANAL_3,ID_CANAL_4

# IDs de los dos canales que utilizarán Postgres Chat Memory.
# Deben coincidir con dos de los canales autorizados anteriormente.
DISCORD_SQL_CHANNEL_IDS=ID_CANAL_3,ID_CANAL_4


# ==========================================
# CONFIGURACIÓN DE LOS WEBHOOKS DE N8N
# ==========================================

# Webhook del workflow original (Simple Memory).
# Reemplazar por la dirección del webhook propio.
N8N_DISCORD_WEBHOOK_URL=http://n8n:5678/webhook/REEMPLAZAR_ID_WEBHOOK_SIMPLE

# Webhook del workflow nuevo (Postgres Chat Memory).
# Reemplazar por la dirección del webhook propio.
N8N_SQL_DISCORD_WEBHOOK_URL=http://n8n:5678/webhook/REEMPLAZAR_ID_WEBHOOK_SQL

# Secreto compartido por ambos workflows.
# Debe coincidir con la autenticación configurada en n8n.
N8N_WEBHOOK_SECRET=


# ==========================================
# CONFIGURACIÓN DE SOLICITUDES
# ==========================================

# Tiempo máximo de espera de las solicitudes, en milisegundos.
DISCORD_REQUEST_TIMEOUT_MS=3600000
