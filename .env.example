# ==========================================
# CONFIGURACIÓN DE N8N
# ==========================================

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false

# Generar una clave propia para cada instalación.
# Ejemplo para generarla: openssl rand -hex 32
N8N_ENCRYPTION_KEY=REEMPLAZAR_CON_CLAVE_PROPIA

# Zona horaria
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota


# ==========================================
# CONFIGURACIÓN DEL BOT DE DISCORD
# ==========================================

# Token del bot de Discord
DISCORD_TOKEN=

# Mapa JSON de IDs de canales a URLs de webhooks de n8n.
# Los canales pueden compartir un webhook; agrega o elimina pares según necesites.
DISCORD_CHANNEL_ROUTES='{"ID_CANAL_1":"http://n8n:5678/webhook/ruta-simple","ID_CANAL_2":"http://n8n:5678/webhook/ruta-simple","ID_CANAL_3":"http://n8n:5678/webhook/ruta-sql","ID_CANAL_4":"http://n8n:5678/webhook/ruta-sql"}'

# Compatibilidad temporal: canales cuyos session_id históricos usan el formato SQL.
# Esta lista solo conserva IDs de sesión; no determina el webhook. Retirarla al migrar sesiones.
DISCORD_LEGACY_SQL_SESSION_CHANNEL_IDS=ID_CANAL_3,ID_CANAL_4


# ==========================================
# CONFIGURACIÓN DE LOS WEBHOOKS DE N8N
# ==========================================

# Secreto compartido por ambos workflows.
# Debe coincidir con la autenticación configurada en n8n.
N8N_WEBHOOK_SECRET=


# ==========================================
# CONFIGURACIÓN DE SOLICITUDES
# ==========================================

# Tiempo máximo de espera de las solicitudes, en milisegundos.
DISCORD_REQUEST_TIMEOUT_MS=3600000
